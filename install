#!/usr/bin/env bash

if [[ -z $STOW_FOLDERS ]]; then
    STOW_FOLDERS="bash,bin,nvim,rofi,sway,terms,tmux"
fi

if [[ -z $DOTFILES ]]; then
    DOTFILES=$HOME/.dotfiles
fi

unlink ~/.bashrc || rm ~/.bashrc
unlink ~/.profile || rm ~/.profile
unlink ~/.inputrc || rm ~/.inputrc

for folder in $(echo $STOW_FOLDERS | sed "s/,/ /g"); do
    echo "stow $folder"
    # stow -D $folder
    stow $folder
done
