#!/bin/bash

git clone --bare https://github.com/kojogadget/dotfiles $HOME/.dotfiles

# Setup fzf
git clone --depth 1 https://github.com/junegunn/fzf.git $HOME/.fzf
$HOME/.fzf/install --all

function config {
   /usr/bin/git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME $@
}
mkdir -p $HOME/Projects/legacy/config-backup
config checkout
if [ $? = 0 ]; then
  echo "Checked out config.";
  else
    echo "Backing up pre-existing dot files.";
    config checkout 2>&1 | egrep "\s+\." | awk {'print $1'} | xargs -I{} mv {} $HOME/Projects/legacy/config-backup/{}
fi;
config checkout
config config status.showUntrackedFiles no
